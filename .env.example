# --- Obligatoire ---------------------------------------------------------
# Clé API créée sur https://console.anthropic.com (Settings > API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Mot de passe de la base PostgreSQL (choisis-en un long)
POSTGRES_PASSWORD=change-moi-par-un-long-mot-de-passe

# Compte administrateur créé au premier démarrage (mot de passe : 10 caractères minimum)
ADMIN_EMAIL=tech.terangasn@gmail.com
ADMIN_PASSWORD=change-moi-aussi
ADMIN_NAME=Théo

# --- Optionnel -----------------------------------------------------------
# Nom affiché dans l'interface (pris en compte au build)
NEXT_PUBLIC_BRAND=Tech Teranga

# Port local exposé (le reverse proxy pointe dessus)
APP_PORT=3000

# Mettre à false UNIQUEMENT pour tester en http sans HTTPS (sinon la connexion ne tient pas)
COOKIE_SECURE=true

# Modèles par niveau (Rapide / Standard / Approfondi)
MODEL_RAPIDE=claude-haiku-4-5
MODEL_STANDARD=claude-sonnet-5-5
MODEL_APPROFONDI=claude-opus-5-5

# Recherche web
MAX_SEARCHES_PER_MISSION=5
SEARCH_CITY=
SEARCH_COUNTRY=
SEARCH_TIMEZONE=
WEB_SEARCH_USD=0.01

# Longueur maximale d'une réponse (tokens)
MAX_TOKENS=16000

# Taux d'affichage des coûts en FCFA
USD_TO_XOF=600

# --- Studio vidéo (optionnel) ---------------------------------------------
# Les clés peuvent aussi être saisies dans Administration > Fournisseurs vidéo
# (stockées chiffrées en base). Une valeur ici a la priorité.
# fal.ai : images, plans vidéo, avatar parlant, voix clonée, musique (https://fal.ai/dashboard/keys)
FAL_KEY=
# ElevenLabs : voix clonée plus fine, sur abonnement
ELEVENLABS_API_KEY=
# Secret de chiffrement des clés saisies dans l'admin (à défaut : POSTGRES_PASSWORD).
# Ne pas le changer après coup, sinon les clés enregistrées devront être ressaisies.
SETTINGS_SECRET=
